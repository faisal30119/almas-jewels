{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "A jewelry product",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "price": { "type": "number" },
        "image": { "type": "string" },
        "category": { "type": "string" },
        "stoneColor": { "type": "string" },
        "plating": { "type": "string" },
        "description": { "type": "string" },
        "inclusions": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "required": ["name", "price"]
    },
    "Order": {
      "title": "Order",
      "description": "An order placed by a user",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "orderId": { "type": "string" },
        "amount": { "type": "number" },
        "status": { "type": "string" }
      },
      "required": ["userId", "orderId", "amount"]
    },
    "User": {
      "title": "User",
      "description": "User profile with wishlist",
      "type": "object",
      "properties": {
        "wishlist": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  },
  "firestore": {
    "products/{productId}": {
      "schema": "Product",
      "description": "Products available in the store"
    },
    "orders/{orderId}": {
      "schema": "Order",
      "description": "User orders"
    },
    "users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    }
  }
}
